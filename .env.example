# Salin ke .env dan isi dengan nilai dari Supabase Dashboard → Project Settings → API.
# Jangan pernah commit .env yang berisi nilai asli.

# Publik (boleh terkirim ke browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only — JANGAN beri prefix NEXT_PUBLIC_ (melewati RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server only. Required for fresh AI text generation; use a unique strong random secret (32+ characters).
RATE_LIMIT_HMAC_KEY=
AI_DAILY_GENERATION_LIMIT=100

# Explicit opt-in for local development only; leave disabled elsewhere.
CAMPAIGN_DISCUSSION_PROVIDER=
CAMPAIGN_DISCUSSION_CONTEXT=
CAMPAIGN_BLUEPRINT_PROVIDER=
CAMPAIGN_BLUEPRINT_APPROVAL=
CAMPAIGN_EXECUTION_MODE=
CAMPAIGN_EVALUATION_MODE=
# Real generation is separate from synthetic analytics; fake is test-only.
CAMPAIGN_EVALUATION_PROVIDER=gemini

# Server only. Required for Gemini discussion, blueprint, evaluation, memory or embeddings.
# Obtain the text model from local configuration/model metadata; never use the embedding model here.
GEMINI_API_KEY=
GEMINI_MODEL=
# Total deadline (10..120000 ms); manual development uses one attempt, no fallback.
GEMINI_TIMEOUT_MS=60000
# Opsional: alamat API kompatibel OpenAI (misalnya CosmosHub) untuk semua modul AI. Kosongkan untuk memakai Google Gemini.
GEMINI_BASE_URL=

# Slice 8B development-only memory; verified C6 eligibility remains blocked
CAMPAIGN_MEMORY_PROVIDER=gemini
CAMPAIGN_MEMORY_RETRIEVAL=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Verbose server diagnostics only when NODE_ENV=development; output values are redacted.
GEMINI_DEBUG=false

# Midtrans Sandbox — hanya server; isi di .env.local, jangan kirim key lewat chat/log.
# Key harus berasal dari dashboard Sandbox (prefix SB-Mid-server-).
MIDTRANS_SERVER_KEY=
MIDTRANS_MERCHANT_ID=
# Pilihan: gopay atau "airpay shopee".
MIDTRANS_QRIS_ACQUIRER=gopay

# TTL hold sementara; final setelah uji expiry QRIS di akun tim (OG-02).
# ORDER_HOLD_TTL_SECONDS=900

# Email konfirmasi lunas. Kosongkan EMAIL_PROVIDER agar email tetap mengantre tanpa dikirim.
# resend: butuh RESEND_API_KEY dan EMAIL_FROM dengan domain terverifikasi. mailpit: hanya lokal (Supabase CLI, port 54324).
EMAIL_PROVIDER=
EMAIL_FROM=
# Alamat dasar aplikasi untuk tautan dan logo di email, misalnya http://localhost:3001 atau domain deploy.
APP_URL=
RESEND_API_KEY=
# MAILPIT_URL=http://127.0.0.1:54324

# Route /api/jobs/run (cron): header Authorization: Bearer <CRON_SECRET>, minimal 16 karakter acak.
CRON_SECRET=
