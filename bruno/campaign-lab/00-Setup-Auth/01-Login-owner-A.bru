meta {
  name: [MUTATING] Login-owner-A
  type: http
  seq: 1
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions/auth
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "{{ownerPassword}}"
  }
}

script:pre-request {
  if (bru.getVar('allowAuth') !== 'true') throw new Error('OPT_IN_REQUIRED: allowAuth=true');
  if (!bru.getVar('ownerEmail')) throw new Error('PREREQUISITE_REQUIRED: ownerEmail; execute the preceding documented request');
  if (!bru.getVar('ownerPassword')) throw new Error('PREREQUISITE_REQUIRED: ownerPassword; execute the preceding documented request');
  req.setBody({email:bru.getVar('ownerEmail'),password:bru.getVar('ownerPassword')});
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().success!==true) throw new Error('Login failed');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: none; start local services and configure private owner credentials.
  Prerequisites: ownerEmail, ownerPassword.
  Required opt-in flags: allowAuth.
  First request. Put values in Bruno local Secret Variables; cookies are returned as HttpOnly Set-Cookie, never JSON tokens.
}
