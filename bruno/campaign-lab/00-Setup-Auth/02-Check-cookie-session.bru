}

get {
  url: {{baseUrl}}/api/dev/discussions/auth
  body: none
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

script:pre-request {
  
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().authenticated!==true) throw new Error('Not authenticated');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  READ-ONLY. Expected HTTP 200.
  Previous request in workflow: 00-Setup-Auth/01-Login-owner-A.bru.
  Prerequisites: local development server; configuration per README.
  Required opt-in flags: none; authenticated reads still need a valid cookie.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
