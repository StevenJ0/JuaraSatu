meta {
  name: [MUTATING] Create-session
  type: http
  seq: 1
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "create",
    "preorderId": "{{preorderId}}"
  }
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('preorderId')) throw new Error('PREREQUISITE_REQUIRED: preorderId; execute the preceding documented request');
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(!res.getBody().session.id)throw new Error('Session ID missing');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 00-Setup-Auth/03-List-preorders-and-discussions.bru.
  Prerequisites: preorderId.
  Required opt-in flags: allowMutations.
  Creates one new persistent session in the authenticated owner business. No client businessId.
}
