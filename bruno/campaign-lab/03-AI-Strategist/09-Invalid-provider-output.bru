meta {
  name: [NEGATIVE] Invalid-provider-output
  type: http
  seq: 9
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "send",
    "sessionId": "{{sessionId}}",
    "requestKey": "{{requestId}}",
    "expectedVersion": {{expectedVersion}},
    "expectedContextHash": "{{discussionHash}}",
    "message": "Pengujian output sintetis invalid",
    "preferences": {
      "budgetCapIdr": 50000,
      "allowDiscount": true,
      "channels": [
        "whatsapp"
      ]
    },
    "scenario": "invalid"
  }
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('sessionId')) throw new Error('PREREQUISITE_REQUIRED: sessionId; execute the preceding documented request');
  if (!bru.getVar('expectedVersion')) throw new Error('PREREQUISITE_REQUIRED: expectedVersion; execute the preceding documented request');
  if (!bru.getVar('discussionHash')) throw new Error('PREREQUISITE_REQUIRED: discussionHash; execute the preceding documented request');
  bru.setVar('requestId',bru.interpolate('{{$randomUUID}}'));
}

tests {
  test('HTTP 502 / INVALID_RESPONSE', function () {
    if(res.getStatus()!==502) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!=='INVALID_RESPONSE') throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Expected HTTP 502 code=INVALID_RESPONSE.
  Previous request in workflow: 03-AI-Strategist/08-Reload-after-timeout.bru.
  Prerequisites: sessionId, expectedVersion, discussionHash.
  Required opt-in flags: allowNegative, allowMutations.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
