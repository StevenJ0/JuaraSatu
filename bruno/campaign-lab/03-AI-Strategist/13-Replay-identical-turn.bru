meta {
  name: [MUTATING] Replay-identical-turn
  type: http
  seq: 13
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {{lastTurnBody}}
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('lastTurnBody')) throw new Error('PREREQUISITE_REQUIRED: lastTurnBody; execute the preceding documented request');
  req.setBody(JSON.parse(bru.getVar('lastTurnBody')));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().replayed!==true)throw new Error('Replay not reconciled');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 03-AI-Strategist/12-Reload-final-proposal-and-version.bru.
  Prerequisites: lastTurnBody.
  Required opt-in flags: allowMutations.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
