meta {
  name: [NEGATIVE] Conflicting-duplicate-turn
  type: http
  seq: 14
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {{lastTurnBody}}
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('lastTurnBody')) throw new Error('PREREQUISITE_REQUIRED: lastTurnBody; execute the preceding documented request');
  const b=JSON.parse(bru.getVar('lastTurnBody'));b.message='Conflicting payload for same key';req.setBody(b);
}

tests {
  test('HTTP 409 / IDEMPOTENCY_CONFLICT', function () {
    if(res.getStatus()!==409) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!=='IDEMPOTENCY_CONFLICT') throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Expected HTTP 409 code=IDEMPOTENCY_CONFLICT.
  Previous request in workflow: 03-AI-Strategist/13-Replay-identical-turn.bru.
  Prerequisites: lastTurnBody.
  Required opt-in flags: allowNegative, allowMutations.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
