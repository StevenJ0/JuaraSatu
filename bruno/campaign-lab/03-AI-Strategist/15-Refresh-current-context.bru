meta {
  name: [MUTATING] Refresh-current-context
  type: http
  seq: 15
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "refresh",
    "sessionId": "{{sessionId}}",
    "expectedVersion": {{expectedVersion}}
  }
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('sessionId')) throw new Error('PREREQUISITE_REQUIRED: sessionId; execute the preceding documented request');
  if (!bru.getVar('expectedVersion')) throw new Error('PREREQUISITE_REQUIRED: expectedVersion; execute the preceding documented request');
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 03-AI-Strategist/14-Conflicting-duplicate-turn.bru.
  Prerequisites: sessionId, expectedVersion.
  Required opt-in flags: allowMutations.
  Retains history and refreshes context, advancing session version; same unchanged facts hash does not invent a new proposal.
}
