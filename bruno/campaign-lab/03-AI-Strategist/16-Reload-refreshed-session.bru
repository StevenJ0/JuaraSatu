meta {
  name: [READ-ONLY] Reload-refreshed-session
  type: http
  seq: 16
  tags: [
    read-only
  ]
}

get {
  url: {{baseUrl}}/api/dev/discussions?sessionId={{sessionId}}
  body: none
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

script:pre-request {
  if (!bru.getVar('sessionId')) throw new Error('PREREQUISITE_REQUIRED: sessionId; execute the preceding documented request');
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().session.id!==bru.getVar('sessionId'))throw new Error('Wrong session');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  READ-ONLY. Expected HTTP 200.
  Previous request in workflow: 03-AI-Strategist/15-Refresh-current-context.bru.
  Prerequisites: sessionId.
  Required opt-in flags: none; authenticated reads still need a valid cookie.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
