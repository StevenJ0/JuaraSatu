meta {
  name: [BLOCKED] Recover-interrupted-generation
  type: http
  seq: 17
  tags: [
    blocked
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "recover",
    "sessionId": "{{sessionId}}",
    "generationId": "{{generationId}}",
    "expectedVersion": {{expectedVersion}}
  }
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (bru.getVar('allowRecovery') !== 'true') throw new Error('OPT_IN_REQUIRED: allowRecovery=true');
  if (!bru.getVar('sessionId')) throw new Error('PREREQUISITE_REQUIRED: sessionId; execute the preceding documented request');
  if (!bru.getVar('generationId')) throw new Error('PREREQUISITE_REQUIRED: generationId; execute the preceding documented request');
  if (!bru.getVar('expectedVersion')) throw new Error('PREREQUISITE_REQUIRED: expectedVersion; execute the preceding documented request');
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  BLOCKED. Expected HTTP 200.
  Previous request in workflow: 03-AI-Strategist/16-Reload-refreshed-session.bru.
  Prerequisites: sessionId, generationId, expectedVersion.
  Required opt-in flags: allowMutations, allowRecovery.
  Do not include in standard run. Requires an actual persisted running generation older than 120 seconds. Fresh/finished generations return409 TURN_IN_PROGRESS. No SQL manipulation supplied.
}
