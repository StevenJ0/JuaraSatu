meta {
  name: [READ-ONLY] List-and-select-persisted-proposal
  type: http
  seq: 1
  tags: [
    read-only
  ]
}

get {
  url: {{baseUrl}}/api/dev/blueprints?sessionId={{sessionId}}
  body: none
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

script:pre-request {
  if (!bru.getVar('sessionId')) throw new Error('PREREQUISITE_REQUIRED: sessionId; execute the preceding documented request');
}

script:post-response {
  if(res.getStatus()===200){const selected=res.getBody().proposals.find(p=>p.eligible);if(!selected)throw new Error('No current eligible persisted proposal');for(const k of ['generationId','proposalVersion','proposalKey'])bru.setVar(k,selected.selection[k]);}
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(!res.getBody().proposals.some(p=>p.eligible))throw new Error('No eligible alternative');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  READ-ONLY. Expected HTTP 200.
  Previous request in workflow: 03-AI-Strategist/16-Reload-refreshed-session.bru.
  Prerequisites: sessionId.
  Required opt-in flags: none; authenticated reads still need a valid cookie.
  Uses actual selection(sessionId,generationId,proposalVersion,proposalKey), not invented proposalId/alternativeId.
}
