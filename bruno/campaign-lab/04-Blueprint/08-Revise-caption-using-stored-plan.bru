meta {
  name: [MUTATING] Revise-caption-using-stored-plan
  type: http
  seq: 8
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/blueprints
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "revise",
    "campaignId": "{{campaignId}}",
    "requestId": "{{requestId}}",
    "expectedCampaignVersion": {{campaignVersion}},
    "expectedBlueprintId": "{{blueprintId}}",
    "expectedBlueprintVersion": {{blueprintVersion}},
    "edits": {
      "title": "{{blueprintTitle}}",
      "marketingApproach": "{{marketingApproach}}",
      "discountBps": {{discountBps}},
      "budgetCapIdr": {{budgetCapIdr}},
      "targetAdditionalUnits": {{targetAdditionalUnits}},
      "startsAt": "{{startsAt}}",
      "endsAt": "{{endsAt}}",
      "channels": [
        "whatsapp"
      ],
      "notes": "Bruno synthetic revision; financial facts remain server validated",
      "plan": {{editedPlanJson}}
    },
    "scenario": "valid"
  }
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('blueprintPlanJson')) throw new Error('PREREQUISITE_REQUIRED: blueprintPlanJson; execute the preceding documented request');
  if (!bru.getVar('blueprintId')) throw new Error('PREREQUISITE_REQUIRED: blueprintId; execute the preceding documented request');
  if (!bru.getVar('campaignVersion')) throw new Error('PREREQUISITE_REQUIRED: campaignVersion; execute the preceding documented request');
  bru.setVar('requestId',bru.interpolate('{{$randomUUID}}'));
  const plan=JSON.parse(bru.getVar('blueprintPlanJson'));plan.contents[0].body='Pengingat preorder sintetis. Periksa ketentuan dan jadwal pada halaman preorder.';bru.setVar('editedPlanJson',JSON.stringify(plan));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 04-Blueprint/07-Save-blueprint-revision.bru.
  Prerequisites: blueprintPlanJson, blueprintId, campaignVersion.
  Required opt-in flags: allowMutations.
  Uses the complete actual plan captured from active.blueprint_json and edits one caption. Tasks/goal/checklist edits must retain BlueprintPlanSchema fields and dates inside window.
}
