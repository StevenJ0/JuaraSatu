meta {
  name: [NEGATIVE] Reject-publish-before-approval
  type: http
  seq: 10
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/api/dev/campaigns
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "publish",
    "campaignId": "{{campaignId}}",
    "blueprintId": "{{blueprintId}}",
    "expectedBlueprintVersion": {{blueprintVersion}},
    "expectedCampaignVersion": {{campaignVersion}},
    "expectedContextHash": "{{blueprintHash}}",
    "confirm": true
  }
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (bru.getVar('allowLifecycle') !== 'true') throw new Error('OPT_IN_REQUIRED: allowLifecycle=true');
  if (!bru.getVar('blueprintId')) throw new Error('PREREQUISITE_REQUIRED: blueprintId; execute the preceding documented request');
  if (!bru.getVar('campaignVersion')) throw new Error('PREREQUISITE_REQUIRED: campaignVersion; execute the preceding documented request');
}

tests {
  test('HTTP 409 / BLUEPRINT_NOT_APPROVED', function () {
    if(res.getStatus()!==409) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!=='BLUEPRINT_NOT_APPROVED') throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Expected HTTP 409 code=BLUEPRINT_NOT_APPROVED.
  Previous request in workflow: 04-Blueprint/09-Read-latest-revision.bru.
  Prerequisites: blueprintId, campaignVersion.
  Required opt-in flags: allowNegative, allowMutations, allowLifecycle.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
