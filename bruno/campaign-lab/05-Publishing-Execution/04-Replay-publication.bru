meta {
  name: [MUTATING] Replay-publication
  type: http
  seq: 4
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/campaigns
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {{publishBody}}
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (bru.getVar('allowLifecycle') !== 'true') throw new Error('OPT_IN_REQUIRED: allowLifecycle=true');
  if (!bru.getVar('publishBody')) throw new Error('PREREQUISITE_REQUIRED: publishBody; execute the preceding documented request');
  req.setBody(JSON.parse(bru.getVar('publishBody')));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().replayed!==true)throw new Error('Expected publish replay');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 05-Publishing-Execution/03-Publish-explicitly.bru.
  Prerequisites: publishBody.
  Required opt-in flags: allowMutations, allowLifecycle.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
