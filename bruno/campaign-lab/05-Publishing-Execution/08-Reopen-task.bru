meta {
  name: [MUTATING] Reopen-task
  type: http
  seq: 8
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/campaigns
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "task",
    "campaignId": "{{campaignId}}",
    "blueprintId": "{{blueprintId}}",
    "taskId": "{{taskId}}",
    "expectedTaskVersion": {{taskVersion}},
    "completed": false
  }
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('taskId')) throw new Error('PREREQUISITE_REQUIRED: taskId; execute the preceding documented request');
  if (!bru.getVar('taskVersion')) throw new Error('PREREQUISITE_REQUIRED: taskVersion; execute the preceding documented request');
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(Boolean(res.getBody().tasks.find(t=>t.id===bru.getVar('taskId')).completed_at)!==false)throw new Error('Task state mismatch');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 05-Publishing-Execution/07-Complete-task.bru.
  Prerequisites: taskId, taskVersion.
  Required opt-in flags: allowMutations.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
