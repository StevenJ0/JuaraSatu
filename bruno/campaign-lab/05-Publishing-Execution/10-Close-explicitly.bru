meta {
  name: [MUTATING] Close-explicitly
  type: http
  seq: 10
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/campaigns
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "close",
    "campaignId": "{{campaignId}}",
    "expectedCampaignVersion": {{campaignVersion}},
    "confirm": true
  }
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (bru.getVar('allowLifecycle') !== 'true') throw new Error('OPT_IN_REQUIRED: allowLifecycle=true');
  if (!bru.getVar('campaignId')) throw new Error('PREREQUISITE_REQUIRED: campaignId; execute the preceding documented request');
  if (!bru.getVar('campaignVersion')) throw new Error('PREREQUISITE_REQUIRED: campaignVersion; execute the preceding documented request');
  const raw=req.getBody();const payload=JSON.parse(bru.interpolate(typeof raw==='string'?raw:JSON.stringify(raw)));req.setBody(payload);bru.setVar('closeBody',JSON.stringify(payload));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().campaign.status!=='closed'||res.getBody().c3.eligible!==false)throw new Error('Closed offer still eligible');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 05-Publishing-Execution/09-Reload-task-progress.bru.
  Prerequisites: campaignId, campaignVersion.
  Required opt-in flags: allowMutations, allowLifecycle.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
