meta {
  name: [MUTATING] Replay-close-before-finalization
  type: http
  seq: 11
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/campaigns
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {{closeBody}}
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (bru.getVar('allowLifecycle') !== 'true') throw new Error('OPT_IN_REQUIRED: allowLifecycle=true');
  if (!bru.getVar('closeBody')) throw new Error('PREREQUISITE_REQUIRED: closeBody; execute the preceding documented request');
  req.setBody(JSON.parse(bru.getVar('closeBody')));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().replayed!==true)throw new Error('Expected close replay');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 05-Publishing-Execution/10-Close-explicitly.bru.
  Prerequisites: closeBody.
  Required opt-in flags: allowMutations, allowLifecycle.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
