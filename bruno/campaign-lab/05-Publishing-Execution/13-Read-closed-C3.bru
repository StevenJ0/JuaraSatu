meta {
  name: [READ-ONLY] Read-closed-C3
  type: http
  seq: 13
  tags: [
    read-only
  ]
}

get {
  url: {{baseUrl}}/api/dev/campaigns?preorderId={{preorderId}}
  body: none
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

script:pre-request {
  if (!bru.getVar('preorderId')) throw new Error('PREREQUISITE_REQUIRED: preorderId; execute the preceding documented request');
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().eligible!==false)throw new Error('Closed offer must not be eligible');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  READ-ONLY. Expected HTTP 200.
  Previous request in workflow: 05-Publishing-Execution/12-Read-closed-history.bru.
  Prerequisites: preorderId.
  Required opt-in flags: none; authenticated reads still need a valid cookie.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
