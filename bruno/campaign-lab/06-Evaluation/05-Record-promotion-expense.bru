meta {
  name: [MUTATING] Record-promotion-expense
  type: http
  seq: 5
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/evaluations
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "create_cost",
    "campaignId": "{{campaignId}}",
    "requestId": "{{requestId}}",
    "category": "advertising",
    "description": "Bruno isolated synthetic expense",
    "amountIdr": 50000,
    "incurredAt": "{{incurredAt}}"
  }
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('campaignId')) throw new Error('PREREQUISITE_REQUIRED: campaignId; execute the preceding documented request');
  bru.setVar('requestId',bru.interpolate('{{$randomUUID}}'));
  bru.setVar('incurredAt',new Date(Date.now()-1000).toISOString());
  const raw=req.getBody();const payload=JSON.parse(bru.interpolate(typeof raw==='string'?raw:JSON.stringify(raw)));req.setBody(payload);bru.setVar('costBody',JSON.stringify(payload));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 06-Evaluation/04-Read-known-zero-spend.bru.
  Prerequisites: campaignId.
  Required opt-in flags: allowMutations.
  Owner-reported synthetic expense, not revenue/payment. Server IDR integer0..1e9, incurredAt cannot be future.
}
