meta {
  name: [READ-ONLY] Read-high_spend-KPI
  type: http
  seq: 15
  tags: [
    read-only
  ]
}

get {
  url: {{baseUrl}}/api/dev/evaluations?campaignId={{campaignId}}&scenario=high_spend
  body: none
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

script:pre-request {
  if (!bru.getVar('campaignId')) throw new Error('PREREQUISITE_REQUIRED: campaignId; execute the preceding documented request');
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().synthetic!==true)throw new Error('Expected explicitly synthetic KPI');
    
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  READ-ONLY. Expected HTTP 200.
  Previous request in workflow: 06-Evaluation/14-Read-below_target-KPI.bru.
  Prerequisites: campaignId.
  Required opt-in flags: none; authenticated reads still need a valid cookie.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
