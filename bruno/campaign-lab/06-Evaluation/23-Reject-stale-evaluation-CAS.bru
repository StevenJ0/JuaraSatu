meta {
  name: [NEGATIVE] Reject-stale-evaluation-CAS
  type: http
  seq: 23
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/api/dev/evaluations
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "generate",
    "campaignId": "{{campaignId}}",
    "requestId": "{{requestId}}",
    "expectedCampaignVersion": {{campaignVersion}},
    "expectedEvaluationId": null,
    "expectedContextHash": "{{evaluationHash}}",
    "analyticsScenario": "exceeds_target",
    "providerScenario": "valid"
  }
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('campaignVersion')) throw new Error('PREREQUISITE_REQUIRED: campaignVersion; execute the preceding documented request');
  if (!bru.getVar('evaluationHash')) throw new Error('PREREQUISITE_REQUIRED: evaluationHash; execute the preceding documented request');
  bru.setVar('requestId',bru.interpolate('{{$randomUUID}}'));
}

tests {
  test('HTTP 409 / STALE_EVALUATION_VERSION', function () {
    if(res.getStatus()!==409) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!=='STALE_EVALUATION_VERSION') throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Expected HTTP 409 code=STALE_EVALUATION_VERSION.
  Previous request in workflow: 06-Evaluation/22-Persist-invalid-evaluation.bru.
  Prerequisites: campaignVersion, evaluationHash.
  Required opt-in flags: allowNegative, allowMutations.
  Run after the two saved failure snapshots; latest UUID is no longer null. No new row should be saved.
}
