meta {
  name: [MUTATING] Generate-and-save-valid-evaluation
  type: http
  seq: 26
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/evaluations
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "generate",
    "campaignId": "{{campaignId}}",
    "requestId": "{{requestId}}",
    "expectedCampaignVersion": {{campaignVersion}},
    "expectedEvaluationId": {{expectedEvaluationIdJson}},
    "expectedContextHash": "{{evaluationHash}}",
    "analyticsScenario": "exceeds_target",
    "providerScenario": "valid"
  }
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('campaignVersion')) throw new Error('PREREQUISITE_REQUIRED: campaignVersion; execute the preceding documented request');
  if (!bru.getVar('evaluationHash')) throw new Error('PREREQUISITE_REQUIRED: evaluationHash; execute the preceding documented request');
  if (!bru.getVar('expectedEvaluationIdJson')) throw new Error('PREREQUISITE_REQUIRED: expectedEvaluationIdJson; execute the preceding documented request');
  bru.setVar('requestId',bru.interpolate('{{$randomUUID}}'));
  const raw=req.getBody();const payload=JSON.parse(bru.interpolate(typeof raw==='string'?raw:JSON.stringify(raw)));req.setBody(payload);bru.setVar('evaluationBody',JSON.stringify(payload));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().history.find(h=>h.row.id===bru.getVar('requestId')).row.analysis_json.status!=='available')throw new Error('Valid Fake analysis missing');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 06-Evaluation/25-Reject-stale-evaluation-context.bru.
  Prerequisites: campaignVersion, evaluationHash, expectedEvaluationIdJson.
  Required opt-in flags: allowMutations.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
