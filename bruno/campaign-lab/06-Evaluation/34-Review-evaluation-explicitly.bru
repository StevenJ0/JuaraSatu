meta {
  name: [MUTATING] Review-evaluation-explicitly
  type: http
  seq: 34
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/evaluations
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "review",
    "campaignId": "{{campaignId}}",
    "requestId": "{{requestId}}",
    "evaluationId": "{{evaluationId}}",
    "expectedCampaignVersion": {{campaignVersion}},
    "expectedContextHash": "{{evaluationHash}}",
    "confirm": true
  }
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('evaluationId')) throw new Error('PREREQUISITE_REQUIRED: evaluationId; execute the preceding documented request');
  if (!bru.getVar('campaignVersion')) throw new Error('PREREQUISITE_REQUIRED: campaignVersion; execute the preceding documented request');
  if (!bru.getVar('evaluationHash')) throw new Error('PREREQUISITE_REQUIRED: evaluationHash; execute the preceding documented request');
  bru.setVar('requestId',bru.interpolate('{{$randomUUID}}'));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().history.find(h=>h.row.id===bru.getVar('requestId')).row.analysis_json.review.status!=='reviewed')throw new Error('Review audit missing');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 06-Evaluation/33-Generate-fresh-after-source-change.bru.
  Prerequisites: evaluationId, campaignVersion, evaluationHash.
  Required opt-in flags: allowMutations.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
