meta {
  name: [MUTATING] Finalize-development-simulation
  type: http
  seq: 36
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/evaluations
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "finalize",
    "campaignId": "{{campaignId}}",
    "requestId": "{{requestId}}",
    "evaluationId": "{{evaluationId}}",
    "expectedCampaignVersion": {{campaignVersion}},
    "expectedContextHash": "{{evaluationHash}}",
    "confirm": true
  }
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (bru.getVar('allowLifecycle') !== 'true') throw new Error('OPT_IN_REQUIRED: allowLifecycle=true');
  if (!bru.getVar('evaluationId')) throw new Error('PREREQUISITE_REQUIRED: evaluationId; execute the preceding documented request');
  if (!bru.getVar('campaignVersion')) throw new Error('PREREQUISITE_REQUIRED: campaignVersion; execute the preceding documented request');
  if (!bru.getVar('evaluationHash')) throw new Error('PREREQUISITE_REQUIRED: evaluationHash; execute the preceding documented request');
  bru.setVar('requestId',bru.interpolate('{{$randomUUID}}'));
  const raw=req.getBody();const payload=JSON.parse(bru.interpolate(typeof raw==='string'?raw:JSON.stringify(raw)));req.setBody(payload);bru.setVar('finalizeBody',JSON.stringify(payload));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().context.snapshot.campaign.status!=='completed'||res.getBody().history.find(h=>h.row.id===bru.getVar('requestId')).row.metrics_json.finalization.mode!=='development_synthetic')throw new Error('Expected audited simulation completion');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 06-Evaluation/35-Read-reviewed-eligibility.bru.
  Prerequisites: evaluationId, campaignVersion, evaluationHash.
  Required opt-in flags: allowMutations, allowLifecycle.
  Irreversible completed state under current lifecycle. Synthetic empty real cohort only; no verified performance or memory eligibility.
}
