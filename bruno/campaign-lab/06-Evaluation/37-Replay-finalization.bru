meta {
  name: [MUTATING] Replay-finalization
  type: http
  seq: 37
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/evaluations
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {{finalizeBody}}
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (bru.getVar('allowLifecycle') !== 'true') throw new Error('OPT_IN_REQUIRED: allowLifecycle=true');
  if (!bru.getVar('finalizeBody')) throw new Error('PREREQUISITE_REQUIRED: finalizeBody; execute the preceding documented request');
  req.setBody(JSON.parse(bru.getVar('finalizeBody')));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().replayed!==true)throw new Error('Expected finalization replay');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 06-Evaluation/36-Finalize-development-simulation.bru.
  Prerequisites: finalizeBody.
  Required opt-in flags: allowMutations, allowLifecycle.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
