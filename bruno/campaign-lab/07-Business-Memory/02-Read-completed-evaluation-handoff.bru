meta {
  name: [READ-ONLY] Read-completed-evaluation-handoff
  type: http
  seq: 2
  tags: [
    read-only
  ]
}

get {
  url: {{baseUrl}}/api/dev/memories?campaignId={{campaignId}}
  body: none
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

script:pre-request {
  if (!bru.getVar('campaignId')) throw new Error('PREREQUISITE_REQUIRED: campaignId; execute the preceding documented request');
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(!res.getBody().source||res.getBody().source.synthetic!==true||res.getBody().source.productionEligible!==false)throw new Error('Expected current synthetic-only handoff');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  READ-ONLY. Expected HTTP 200.
  Previous request in workflow: 07-Business-Memory/01-List-completed-memory-sources.bru.
  Prerequisites: campaignId.
  Required opt-in flags: none; authenticated reads still need a valid cookie.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
