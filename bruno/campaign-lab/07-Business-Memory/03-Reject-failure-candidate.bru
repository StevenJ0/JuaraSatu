meta {
  name: [NEGATIVE] Reject-failure-candidate
  type: http
  seq: 3
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/api/dev/memories
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "generate",
    "campaignId": "{{campaignId}}",
    "evaluationId": "{{sourceEvaluationId}}",
    "expectedContextHash": "{{memorySourceHash}}",
    "requestId": "{{requestId}}",
    "scenario": "failure"
  }
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('sourceEvaluationId')) throw new Error('PREREQUISITE_REQUIRED: sourceEvaluationId; execute the preceding documented request');
  if (!bru.getVar('memorySourceHash')) throw new Error('PREREQUISITE_REQUIRED: memorySourceHash; execute the preceding documented request');
  bru.setVar('requestId',bru.interpolate('{{$randomUUID}}'));
}

tests {
  test('Provider-mode negative scenario rejection', function () {
    const real = bru.getVar('confirmRealGemini') === 'true';
    const expectedStatus = real ? 400 : 503;
    const expectedCode = real ? 'FAKE_SCENARIO_DISABLED' : 'MEMORY_PROVIDER_UNAVAILABLE';
    if(res.getStatus()!==expectedStatus) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!==expectedCode) throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Real Gemini: expected HTTP 400 code=FAKE_SCENARIO_DISABLED before inference.
  Test-only Fake provider: expected HTTP 503 code=MEMORY_PROVIDER_UNAVAILABLE.
  Real mode checks the disabled injection guard; it does not simulate upstream/model-output failure.
  Previous request in workflow: 07-Business-Memory/02-Read-completed-evaluation-handoff.bru.
  Prerequisites: sourceEvaluationId, memorySourceHash.
  Required opt-in flags: allowNegative, allowMutations.
  Must run before first candidate exists, otherwise canonical idempotency returns the saved draft instead of invoking provider.
}
