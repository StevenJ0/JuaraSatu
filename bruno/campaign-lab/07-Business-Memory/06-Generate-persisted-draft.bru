meta {
  name: [MUTATING] Generate-persisted-draft
  type: http
  seq: 6
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/memories
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "generate",
    "campaignId": "{{campaignId}}",
    "evaluationId": "{{sourceEvaluationId}}",
    "expectedContextHash": "{{memorySourceHash}}",
    "requestId": "{{requestId}}",
    "scenario": "valid"
  }
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('sourceEvaluationId')) throw new Error('PREREQUISITE_REQUIRED: sourceEvaluationId; execute the preceding documented request');
  if (!bru.getVar('memorySourceHash')) throw new Error('PREREQUISITE_REQUIRED: memorySourceHash; execute the preceding documented request');
  bru.setVar('requestId',bru.interpolate('{{$randomUUID}}'));
  const raw=req.getBody();const payload=JSON.parse(bru.interpolate(typeof raw==='string'?raw:JSON.stringify(raw)));req.setBody(payload);bru.setVar('memoryBody',JSON.stringify(payload));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().row.review_status!=='draft'||res.getBody().indexing.job!==null)throw new Error('Draft must not enqueue automatically');
  });
}

settings {
  followRedirects: false
  timeout: 90000
}

docs {
  MUTATING. Expected HTTP 200. A real provider call requires separate authorization and verified no-billing eligibility.
  Client observation budget is 90 seconds; provider deadline remains server-controlled (60 seconds locally).
  Previous request in workflow: 07-Business-Memory/05-Reject-missing_evidence-candidate.bru.
  Prerequisites: sourceEvaluationId, memorySourceHash.
  Required opt-in flags: allowMutations.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
