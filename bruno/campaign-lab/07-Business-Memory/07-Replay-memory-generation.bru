meta {
  name: [MUTATING] Replay-memory-generation
  type: http
  seq: 7
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/memories
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {{memoryBody}}
}

script:pre-request {
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('memoryBody')) throw new Error('PREREQUISITE_REQUIRED: memoryBody; execute the preceding documented request');
  req.setBody(JSON.parse(bru.getVar('memoryBody')));
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().replayed!==true)throw new Error('Expected memory replay');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 07-Business-Memory/06-Generate-persisted-draft.bru.
  Prerequisites: memoryBody.
  Required opt-in flags: allowMutations.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
