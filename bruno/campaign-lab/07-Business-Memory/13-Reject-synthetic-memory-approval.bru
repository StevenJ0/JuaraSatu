meta {
  name: [NEGATIVE] Reject-synthetic-memory-approval
  type: http
  seq: 13
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/api/dev/memories
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "approve",
    "memoryId": "{{memoryId}}",
    "expectedContentHash": "{{memoryHash}}",
    "confirm": true
  }
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (bru.getVar('allowLifecycle') !== 'true') throw new Error('OPT_IN_REQUIRED: allowLifecycle=true');
  if (!bru.getVar('memoryId')) throw new Error('PREREQUISITE_REQUIRED: memoryId; execute the preceding documented request');
  if (!bru.getVar('memoryHash')) throw new Error('PREREQUISITE_REQUIRED: memoryHash; execute the preceding documented request');
}

tests {
  test('HTTP 409 / SYNTHETIC_MEMORY_APPROVAL_FORBIDDEN', function () {
    if(res.getStatus()!==409) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!=='SYNTHETIC_MEMORY_APPROVAL_FORBIDDEN') throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Expected HTTP 409 code=SYNTHETIC_MEMORY_APPROVAL_FORBIDDEN.
  Previous request in workflow: 07-Business-Memory/12-Reload-reviewed-candidate.bru.
  Prerequisites: memoryId, memoryHash.
  Required opt-in flags: allowNegative, allowMutations, allowLifecycle.
  Expected policy rejection, not an implementation failure. No production-approved source is fabricated.
}
