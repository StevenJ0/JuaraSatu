meta {
  name: [READ-ONLY] Reload-after-blocked-approval-and-worker
  type: http
  seq: 16
  tags: [
    read-only
  ]
}

get {
  url: {{baseUrl}}/api/dev/memories?memoryId={{memoryId}}
  body: none
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

script:pre-request {
  if (!bru.getVar('memoryId')) throw new Error('PREREQUISITE_REQUIRED: memoryId; execute the preceding documented request');
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().row.review_status!=='draft')throw new Error('Synthetic candidate must remain draft');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  READ-ONLY. Expected HTTP 200.
  Previous request in workflow: 07-Business-Memory/15-Retrieve-historical-memory-expect-cold-start.bru.
  Prerequisites: memoryId.
  Required opt-in flags: none; authenticated reads still need a valid cookie.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
