meta {
  name: [MUTATING] Logout-before-missing-auth
  type: http
  seq: 1
  tags: [
    mutating
  ]
}

delete {
  url: {{baseUrl}}/api/dev/discussions/auth
  body: none
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

script:pre-request {
  if (bru.getVar('allowAuth') !== 'true') throw new Error('OPT_IN_REQUIRED: allowAuth=true');
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().success!==true)throw new Error('Logout failed');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 07-Business-Memory/16-Reload-after-blocked-approval-and-worker.bru.
  Prerequisites: local development server; configuration per README.
  Required opt-in flags: allowAuth, allowNegative.
  Clears application cookies, not a server-wide Supabase bearer-token revocation.
}
