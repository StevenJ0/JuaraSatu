meta {
  name: [NEGATIVE] Invalid-login-credentials
  type: http
  seq: 4
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions/auth
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "email": "synthetic-invalid@campaign-lab.example.test",
    "password": "deliberately-wrong-synthetic-password"
  }
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (bru.getVar('allowAuth') !== 'true') throw new Error('OPT_IN_REQUIRED: allowAuth=true');
}

tests {
  test('HTTP 401 / UNAUTHENTICATED', function () {
    if(res.getStatus()!==401) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!=='UNAUTHENTICATED') throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Expected HTTP 401 code=UNAUTHENTICATED.
  Previous request in workflow: 08-Negative-Security/03-Invalid-or-expired-bearer.bru.
  Prerequisites: local development server; configuration per README.
  Required opt-in flags: allowNegative, allowAuth.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
