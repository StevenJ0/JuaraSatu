meta {
  name: [NEGATIVE] Invalid-UUID-blueprints
  type: http
  seq: 10
  tags: [
    negative
  ]
}

get {
  url: {{baseUrl}}/api/dev/blueprints?campaignId=invalid
  body: none
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
}

tests {
  test('HTTP 400 / INVALID_BLUEPRINT', function () {
    if(res.getStatus()!==400) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!=='INVALID_BLUEPRINT') throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Expected HTTP 400 code=INVALID_BLUEPRINT.
  Previous request in workflow: 08-Negative-Security/09-Invalid-UUID-memories.bru.
  Prerequisites: local development server; configuration per README.
  Required opt-in flags: allowNegative.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
