meta {
  name: [NEGATIVE] Reject-untrusted-origin
  type: http
  seq: 15
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "create",
    "preorderId": "{{preorderId}}"
  }
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('preorderId')) throw new Error('PREREQUISITE_REQUIRED: preorderId; execute the preceding documented request');
  req.setHeader('Origin','https://untrusted.example');
}

tests {
  test('HTTP 403 / FORBIDDEN', function () {
    if(res.getStatus()!==403) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!=='FORBIDDEN') throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Expected HTTP 403 code=FORBIDDEN.
  Previous request in workflow: 08-Negative-Security/14-Oversized-request.bru.
  Prerequisites: preorderId.
  Required opt-in flags: allowNegative, allowMutations.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
