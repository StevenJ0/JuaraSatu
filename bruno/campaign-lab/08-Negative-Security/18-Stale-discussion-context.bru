meta {
  name: [NEGATIVE] Stale-discussion-context
  type: http
  seq: 18
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "send",
    "sessionId": "{{sessionId}}",
    "requestKey": "{{requestId}}",
    "expectedVersion": {{expectedVersion}},
    "expectedContextHash": "{{discussionHash}}",
    "message": "Stale hash rejection",
    "preferences": {
      "budgetCapIdr": 50000,
      "allowDiscount": true,
      "channels": [
        "whatsapp"
      ]
    },
    "scenario": "normal"
  }
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('sessionId')) throw new Error('PREREQUISITE_REQUIRED: sessionId; execute the preceding documented request');
  if (!bru.getVar('expectedVersion')) throw new Error('PREREQUISITE_REQUIRED: expectedVersion; execute the preceding documented request');
  bru.setVar('requestId',bru.interpolate('{{$randomUUID}}'));
  const raw=req.getBody();const b=JSON.parse(bru.interpolate(typeof raw==='string'?raw:JSON.stringify(raw)));b.expectedContextHash='0'.repeat(64);req.setBody(b);
}

tests {
  test('HTTP 409 / STALE_CONTEXT', function () {
    if(res.getStatus()!==409) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!=='STALE_CONTEXT') throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Expected HTTP 409 code=STALE_CONTEXT.
  Previous request in workflow: 08-Negative-Security/17-Stale-discussion-version.bru.
  Prerequisites: sessionId, expectedVersion.
  Required opt-in flags: allowNegative, allowMutations.
  Load current session first if another manual turn changed expectedVersion. Fixed wrong hash tests context-token rejection without mutating source rows.
}
