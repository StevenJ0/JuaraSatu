meta {
  name: [MUTATING] Switch-to-owner-B
  type: http
  seq: 27
  tags: [
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions/auth
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{ownerBEmail}}",
    "password": "{{ownerBPassword}}"
  }
}

script:pre-request {
  if (bru.getVar('allowAuth') !== 'true') throw new Error('OPT_IN_REQUIRED: allowAuth=true');
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (!bru.getVar('ownerBEmail')) throw new Error('PREREQUISITE_REQUIRED: ownerBEmail; execute the preceding documented request');
  if (!bru.getVar('ownerBPassword')) throw new Error('PREREQUISITE_REQUIRED: ownerBPassword; execute the preceding documented request');
  req.setBody({email:bru.getVar('ownerBEmail'),password:bru.getVar('ownerBPassword')});
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 08-Negative-Security/26-Reject-write-after-completion.bru.
  Prerequisites: ownerBEmail, ownerBPassword.
  Required opt-in flags: allowAuth, allowNegative.
  Overwrites the app cookie with owner B. Retain owner-A resource IDs for the following 404 checks.
}
