meta {
  name: [NEGATIVE] Cross-preorder-session-create
  type: http
  seq: 33
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/api/dev/discussions
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "create",
    "preorderId": "{{preorderId}}"
  }
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (!bru.getVar('preorderId')) throw new Error('PREREQUISITE_REQUIRED: preorderId; execute the preceding documented request');
}

tests {
  test('HTTP 404 / NOT_FOUND', function () {
    if(res.getStatus()!==404) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!=='NOT_FOUND') throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Expected HTTP 404 code=NOT_FOUND.
  Previous request in workflow: 08-Negative-Security/32-Cross-tenant-memories.bru.
  Prerequisites: preorderId.
  Required opt-in flags: allowNegative, allowMutations.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
