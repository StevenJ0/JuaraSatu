meta {
  name: [NEGATIVE] Cross-tenant-memory-approval
  type: http
  seq: 36
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/api/dev/memories
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "approve",
    "memoryId": "{{memoryId}}",
    "expectedContentHash": "{{memoryHash}}",
    "confirm": true
  }
}

script:pre-request {
  if (bru.getVar('allowNegative') !== 'true') throw new Error('OPT_IN_REQUIRED: allowNegative=true');
  if (bru.getVar('allowMutations') !== 'true') throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if (bru.getVar('allowLifecycle') !== 'true') throw new Error('OPT_IN_REQUIRED: allowLifecycle=true');
  if (!bru.getVar('memoryId')) throw new Error('PREREQUISITE_REQUIRED: memoryId; execute the preceding documented request');
  if (!bru.getVar('memoryHash')) throw new Error('PREREQUISITE_REQUIRED: memoryHash; execute the preceding documented request');
}

tests {
  test('HTTP 404 / NOT_FOUND', function () {
    if(res.getStatus()!==404) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(res.getBody().code!=='NOT_FOUND') throw new Error('Unexpected safe error code');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  NEGATIVE. Expected HTTP 404 code=NOT_FOUND.
  Previous request in workflow: 08-Negative-Security/35-Cross-tenant-finalization.bru.
  Prerequisites: memoryId, memoryHash.
  Required opt-in flags: allowNegative, allowMutations, allowLifecycle.
  Run in folder sequence. Reload using the next GET to verify actual persisted state.
}
