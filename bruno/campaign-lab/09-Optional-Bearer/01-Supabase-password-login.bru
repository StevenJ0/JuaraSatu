meta {
  name: [MUTATING] Supabase-password-login
  type: http
  seq: 1
  tags: [
    mutating
  ]
}

post {
  url: {{supabaseUrl}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "{{ownerPassword}}"
  }
}

script:pre-request {
  if (bru.getVar('allowAuth') !== 'true') throw new Error('OPT_IN_REQUIRED: allowAuth=true');
  if (bru.getVar('allowDirectAuth') !== 'true') throw new Error('OPT_IN_REQUIRED: allowDirectAuth=true');
  if (!bru.getVar('ownerEmail')) throw new Error('PREREQUISITE_REQUIRED: ownerEmail; execute the preceding documented request');
  if (!bru.getVar('ownerPassword')) throw new Error('PREREQUISITE_REQUIRED: ownerPassword; execute the preceding documented request');
  if (!bru.getVar('supabaseAnonKey')) throw new Error('PREREQUISITE_REQUIRED: supabaseAnonKey; execute the preceding documented request');
  req.setBody({email:bru.getVar('ownerEmail'),password:bru.getVar('ownerPassword')});
  req.setHeader('apikey',bru.getVar('supabaseAnonKey'));
}

script:post-response {
  if(res.getStatus()===200)bru.setVar('accessToken',res.getBody().access_token);
}

tests {
  test('HTTP 200', function () {
    if(res.getStatus()!==200) throw new Error('Unexpected HTTP status: '+res.getStatus());
    if(!res.getBody().access_token)throw new Error('No access token');
  });
}

settings {
  followRedirects: false
  timeout: 30000
}

docs {
  MUTATING. Expected HTTP 200.
  Previous request in workflow: 08-Negative-Security/37-Restore-owner-A-at-end.bru.
  Prerequisites: ownerEmail, ownerPassword, supabaseAnonKey.
  Required opt-in flags: allowAuth, allowDirectAuth.
  Optional alternative auth, not part of cookie workflow. Capture access token in RAM only; do not capture/export refresh token or save response examples.
}
