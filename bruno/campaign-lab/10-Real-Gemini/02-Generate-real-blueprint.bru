meta {
  name: [PAID-OPT-IN] Generate-real-blueprint
  type: http
  seq: 2
  tags: [
    real-gemini
    mutating
  ]
}

post {
  url: {{baseUrl}}/api/dev/blueprints
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Content-Type: application/json
}

body:json {
  {
    "action": "create",
    "selection": {
      "sessionId": "{{sessionId}}",
      "generationId": "{{generationId}}",
      "proposalVersion": {{proposalVersion}},
      "proposalKey": "{{proposalKey}}"
    },
    "campaignId": "{{campaignId}}",
    "requestId": "{{requestId}}"
  }
}

script:pre-request {
  if(bru.getVar('allowMutations')!=='true')throw new Error('OPT_IN_REQUIRED: allowMutations=true');
  if(bru.getVar('confirmRealGemini')!=='true'||bru.getVar('allowPaidRequests')!=='true')throw new Error('OPT_IN_REQUIRED: confirmRealGemini=true and allowPaidRequests=true');
  for(const k of ['sessionId','generationId','proposalVersion','proposalKey'])if(!bru.getVar(k))throw new Error('PREREQUISITE_REQUIRED: '+k);
  bru.setVar('campaignId',bru.interpolate('{{$randomUUID}}'));bru.setVar('requestId',bru.interpolate('{{$randomUUID}}'));
  const raw=req.getBody();req.setBody(JSON.parse(bru.interpolate(typeof raw==='string'?raw:JSON.stringify(raw))));
}

tests {
  test('Gemini blueprint remains proposed/draft and synthetic context is explicit',function(){
    if(res.getStatus()!==200)throw new Error('Gemini blueprint failed: HTTP '+res.getStatus()+' '+res.getBody().code);
    const b=res.getBody(),p=b.active.blueprint_json;
    if(b.campaign.status!=='draft'||b.active.approval_status!=='proposed'||p.provider!=='gemini'||!p.model||p.synthetic!==true)throw new Error('Expected real provider provenance with synthetic context; no automatic approval');
    const id=p.providerRequestId;
    if(id!==null&&(typeof id!=='string'||id.length<1||id.length>256))throw new Error('Expected provider ID or explicit null for an unstored interaction');
  });
}

settings {
  followRedirects: false
  timeout: 90000
}

docs {
  May incur one Gemini generation charge. Run only after reviewing the selected persisted Gemini alternative in 04-Blueprint/01.
  Selection must use actual server generationId/proposalVersion/proposalKey. Do not invent alternativeId/proposalId or financial fields.
  Reload with GET 04-Blueprint/04. Approval/publication are separate explicit operations; this request does neither.
  Do not run the legacy Fake failure/invalid scenario tests in Gemini mode. Context and evaluation remain synthetic.
}
